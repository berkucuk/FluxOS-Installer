#!/bin/bash
# FluxOS Installer - Custom Archinstall with FluxOS Branding
# Usage: sudo ./fluxos-install

# Ensure we're running as root
if [ "$EUID" -ne 0 ]; then
    echo "FluxOS Installer requires root privileges."
    echo "Please run: sudo ./fluxos-install"
    exit 1
fi

# Get the directory where this script is located
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Set PYTHONPATH to use our custom archinstall
export PYTHONPATH="$SCRIPT_DIR:$PYTHONPATH"

# Run our custom archinstall
cd "$SCRIPT_DIR"
python3 -m archinstall "$@"
